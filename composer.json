{
  "name": "satori/satori-suite",
  "description": "SATORI Membership Suite \u2014 monorepo for Core and modules",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "Satori\\": "core/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@phpcs-set"
    ],
    "post-update-cmd": [
      "@phpcs-set"
    ],
    "phpcs-set": [
      "VendorBinPrefixed\\Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run"
    ],
    "lint": [
      "php -l core/satori-core.php"
    ],
    "phpcs": [
      "phpcs --standard=WordPress --extensions=php --ignore=vendor,build,node_modules ."
    ],
    "phpstan": [
      "phpstan analyse core --level=max"
    ]
  },
  "scripts-descriptions": {
    "lint": "Run PHP linter against key entry points",
    "phpcs": "Run PHPCS with WordPress Coding Standards",
    "phpstan": "Run PHPStan static analysis on /core"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}